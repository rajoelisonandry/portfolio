# Public URL of the deployed site (used for canonical URL, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- AI assistant -----------------------------------------------------------
# Google Gemini key, free tier: https://aistudio.google.com/apikey
# Without it, the assistant is disabled.
GEMINI_API_KEY=
# Optional: Gemini model (default: gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional: site-wide daily message budget (default: 300).
# CHAT_DAILY_LIMIT=300
# Optional: set to "false" to switch the assistant off without redeploying code.
# CHAT_ENABLED=true
